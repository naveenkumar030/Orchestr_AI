# SentinelOps Environment Variables Template
# Copy this file to .env and configure your keys

# Ngrok Tunnel Token (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# LambdaTest Cloud Grid Credentials (https://accounts.lambdatest.com/detail/profile)
LT_USERNAME=
LT_ACCESS_KEY=

# GitHub API & Self-Healing Token (repo, workflow scope)
GITHUB_TOKEN=

# Google Gemini API Key for Healer-Alpha Root Cause Analysis
GEMINI_API_KEY=

# Webhook Verification Secret
GITHUB_WEBHOOK_SECRET=
