# SentinelOps Environment Variables Template
# Copy this file to .env and configure your keys

# Ngrok Tunnel Token (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# LambdaTest Cloud Grid Credentials (https://accounts.lambdatest.com/detail/profile)
LT_USERNAME=
LT_ACCESS_KEY=

# GitHub API & Self-Healing Token (repo, workflow scope)
GITHUB_TOKEN=

# Google Gemini API Key for Healer-Alpha Root Cause Analysis
GEMINI_API_KEY=

# Groq Cloud Ultra-Fast LPU API Key (https://console.groq.com)
GROQ_API_KEY=

# OpenAI API Key (https://platform.openai.com)
OPENAI_API_KEY=

# Webhook Verification Secret
GITHUB_WEBHOOK_SECRET=

# Slack Incoming Webhook URL (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# MongoDB Atlas Cloud Document Database (https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sentinelops?retryWrites=true&w=majority
MONGODB_DB=sentinelops

# CORS Allowed Origins (comma-separated, no wildcards)
# Defaults to localhost:5173 and localhost:5000 for development.
# For production, set to your deployed frontend URL(s).
# Example: ALLOWED_ORIGINS=https://sentinelops.example.com,https://dashboard.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
